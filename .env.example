# Vertica connection (used by db_connect.py)
# No .env needed here — weekly_refresh.py uses the shared
# ~/Documents/dev/automation/.env via db_connect.get_connection()
#
# If you need to override, create a .env in this folder with:
# VERTICA_HOST=your_host
# VERTICA_PORT=5433
# VERTICA_DATABASE=your_db
# VERTICA_USER=your_user
# VERTICA_PASSWORD=your_password
